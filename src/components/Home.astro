---
import Base from '../layouts/Base.astro';
import { home, childrenOf, orderedDocuments } from '../lib/documents';
const { Content } = home.markdown;
const collections = childrenOf('');
const introduction = orderedDocuments.find((doc) => doc.isIndex && doc.parent && doc.slug);
const chapters = orderedDocuments.filter((doc) => !doc.isIndex);
---
<Base title={home.title} canonicalPath="/" active="home">
  <main id="main" tabindex="-1" class="home-main">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow" lang="en">A world in words</p>
        <h1 id="home-title">카르틀란</h1>
        <p class="hero-welcome">{home.title}</p>
        <div class="hero-intro"><Content /></div>
        {collections[0] && <a class="primary-link" href={collections[0].href}>세계의 언어 살펴보기 <span aria-hidden="true">↗</span></a>}
      </div>
      <aside class="hero-note" aria-label="기록 안내">
        <span class="note-index" lang="en">Khartllan / Archive</span><span class="note-rule" aria-hidden="true"></span>
        <h2>언어에서 시작하는<br />하나의 세계</h2><p>서로 다른 삶과 문화,<br />그 안에서 태어난 말들을 기록합니다.</p>
        <div class="archive-count"><strong>{orderedDocuments.length - 1}</strong><span>공개된 기록</span></div>
      </aside>
    </section>
    <section class="collections-section" aria-labelledby="collections-title">
      <div class="section-heading"><div><p class="eyebrow" lang="en">Explore the archive</p><h2 id="collections-title">세계의 언어</h2></div><span class="section-aside">언어를 통해 만나는 카르틀란</span></div>
      {collections.map((collection) => <a class="collection-row" href={collection.href}><div><h3>{collection.title}</h3><p>{collection.summary}</p></div><span class="row-arrow" aria-hidden="true">↗</span></a>)}
    </section>
    {introduction && <section class="reading-section" aria-labelledby="reading-title">
      <div class="section-heading"><div><p class="eyebrow" lang="en">Begin reading</p><h2 id="reading-title">기록 읽기</h2></div></div>
      <div class="reading-grid">
        <a class="featured-document" href={introduction.href}><span class="document-kind">언어 소개</span><h3>{introduction.title}</h3><p>{introduction.summary}…</p><span class="text-link">문화와 언어의 배경 읽기 <span aria-hidden="true">→</span></span></a>
        <ol class="chapter-list">{chapters.map((doc, index) => <li><a href={doc.href}><span class="chapter-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span><span class="chapter-context">{introduction.title}</span><strong>{doc.title}</strong></span><span class="row-arrow" aria-hidden="true">→</span></a></li>)}</ol>
      </div>
    </section>}
  </main>
</Base>
